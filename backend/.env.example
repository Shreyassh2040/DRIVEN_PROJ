# Server
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=smart_city

# Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed browser origins when the frontend is served
# separately. The bundled Express server also serves the frontend on PORT.
CLIENT_ORIGIN=http://localhost:5500,http://localhost:3000

# Google Maps Platform (optional). Create a browser key restricted to your
# HTTP referrers and enable Maps JavaScript API + Geocoding API.
# Without a key the UI shows coordinate details and directions links instead
# of an interactive map. No fake map is displayed.
GOOGLE_MAPS_API_KEY=

# Uploads
MAX_UPLOAD_MB=5
